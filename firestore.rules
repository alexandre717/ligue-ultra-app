rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Membres — chacun peut lire son profil, admin peut écrire
    match /members/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || request.auth.token.role == 'admin';
    }
    
    // Événements — tous les members peuvent lire, admin crée/modifie
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.token.role == 'admin';
    }
    
    // Invitations — admin uniquement
    match /invitations/{inviteId} {
      allow read, write: if request.auth.token.role == 'admin';
    }
  }
}
